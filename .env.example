# MSC 配置模板 —— 复制为 .env 后按需修改
# docker compose 会自动读取同目录的 .env

# 数据库 / 目录（容器内路径，改名需同步 docker-compose.yml 的 volume）
MSC_DB_PATH=/app/data/msc.db
MSC_MEMORY_DIR=/home/astro/.msc/memory
MSC_CLAUDE_MEMORY_DIR=/home/astro/.claude/projects/-home-astro/memory
MSC_BACKUP_DIR=/app/backups

# 服务
MSC_BIND_HOST=0.0.0.0
MSC_BIND_PORT=8000
MSC_CORS_ORIGINS=["*"]
# 其他机器上的 agent 访问时用的地址，只影响 /api/v1/help 与 /llms.txt 里的示例
MSC_PUBLIC_URL=
# 紧急开关：只读模式，所有写操作返回 423
MSC_READ_ONLY=false
# /api/v1/health 是否包含数据库/搜索索引自检
MSC_HEALTH_DETAIL=true

# 鉴权
# false = 局域网免登录模式（默认）：API 与 Web UI 直接可用，不存在 token 过期
# true  = 启用 JWT / API Key 鉴权，下面的 SECRET_KEY 与 INITIAL_ADMIN_KEY 才生效
MSC_AUTH_ENABLED=false
MSC_SECRET_KEY=change-me-to-random-string
MSC_INITIAL_ADMIN_KEY=

# 后台任务
# 文件系统 → 数据库的轮询间隔（秒）
MSC_SYNC_INTERVAL_SECONDS=60
# 自动备份保留多少个归档（0 = 不清理）
MSC_BACKUP_KEEP=14

# 模型卡片（记忆小结）—— 这里只是首次启动的默认值，
# 之后在 Web UI「设置 → 模型卡片」里改就行，改完立即生效。
# 任何 OpenAI 兼容端点都可以：LM Studio / llama.cpp / ollama / vLLM。
MSC_LLM_BASE_URL=
MSC_LLM_MODEL=
MSC_LLM_API_KEY=
MSC_LLM_TEMPERATURE=0.2
MSC_LLM_MAX_TOKENS=1500
MSC_LLM_TIMEOUT_SECONDS=180
# 送入模型的正文总长度上限（小模型上下文短，超了先丢最旧的）
MSC_LLM_MAX_INPUT_CHARS=12000

# 每日自动小结（也可在设置页开关）
MSC_SUMMARY_AUTO_ENABLED=false
# 触发时间，按 MSC_SUMMARY_TIMEZONE 解读；留空＝容器本地时区（官方镜像里是 UTC）
MSC_SUMMARY_AUTO_TIME=23:30
MSC_SUMMARY_TIMEZONE=
MSC_SUMMARY_CATEGORY=project
MSC_SUMMARY_PRIORITY=medium
# true = 小结把原始记忆软删除（可恢复）；false = 原样保留
MSC_SUMMARY_ARCHIVE_SOURCES=false

# RAG（语义搜索 / 语音 / 洞察）—— 同样是首启 seed，之后以数据库里的卡片为准。
# 紧急开关：false = 行为和 2.2.0 完全一致（FTS only），worker 不启动。
MSC_RAG_ENABLED=true
# 嵌入模型（llama.cpp 需 -ub 4096 才能嵌长文；Ollama 用新版 /v1/embeddings 兼容口）
MSC_EMBED_BASE_URL=
MSC_EMBED_MODEL=
MSC_EMBED_API_KEY=
# 重排（可选，llama.cpp --rerank 的 /v1/rerank 或 Cohere 方言）
MSC_RERANK_BASE_URL=
MSC_RERANK_MODEL=
MSC_RERANK_API_KEY=
# 语音转写（llama-server whisper）
MSC_WHISPER_BASE_URL=
MSC_WHISPER_MODEL=
MSC_WHISPER_API_KEY=
# 回响评注专用模型（chat 式 OpenAI 接口；留空＝评注回退 chat 卡）
MSC_ECHO_BASE_URL=
MSC_ECHO_MODEL=
MSC_ECHO_API_KEY=
# 评注 md 保存的 base 目录；留空＝记忆目录（sync 会自动把评注吸收为普通记忆）
MSC_ECHO_DIR=
# 融合调参（也可在设置页改，DB 优先）
MSC_RAG_RECALL_TOP=30
MSC_RAG_RERANK_TOPN=10
MSC_RAG_RRF_K=60
MSC_RAG_EMBED_BATCH=16
